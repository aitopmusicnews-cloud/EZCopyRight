# AWS Amplify build variables (public browser configuration)
VITE_API_BASE_URL=https://your-service.region.awsapprunner.com
VITE_COGNITO_REGION=us-west-2
VITE_COGNITO_CLIENT_ID=your_cognito_app_client_id

# AWS App Runner runtime configuration
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true
COGNITO_REGION=us-west-2
COGNITO_USER_POOL_ID=your_cognito_user_pool_id
COGNITO_CLIENT_ID=your_cognito_app_client_id
CORS_ALLOWED_ORIGINS=https://your-amplify-domain.example,https://your-custom-domain.example
APP_BASE_URL=https://your-custom-domain.example
POLICY_VERSION=2026-08-13
AWS_REGION=us-west-2
S3_BUCKET=your-private-audio-bucket
STRIPE_SECRET_KEY=store_in_aws_secrets_manager
STRIPE_WEBHOOK_SECRET=store_in_aws_secrets_manager
STRIPE_PRICE_ID=price_your_recurring_price
MONTHLY_REGISTRATION_LIMIT=5
MAX_UPLOAD_BYTES=536870912
