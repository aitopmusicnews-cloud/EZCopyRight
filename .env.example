# Browser configuration
# Production uses the same origin for React + API, so VITE_API_BASE_URL can stay empty.
VITE_API_BASE_URL=

# Server runtime
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true
CORS_ALLOWED_ORIGINS=https://ezwaycopyrights.com
APP_BASE_URL=https://ezwaycopyrights.com
POLICY_VERSION=2026-08-13

# Azure Blob Storage
STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_CONTAINER=private-audio
AZURE_STORAGE_ACCOUNT_KEY=store_as_container_app_secret
AZURE_LOCATION=eastus2

# Stripe
STRIPE_SECRET_KEY=store_as_container_app_secret
STRIPE_WEBHOOK_SECRET=store_as_container_app_secret
STRIPE_PRICE_ID=price_your_recurring_price
MONTHLY_REGISTRATION_LIMIT=5
MAX_UPLOAD_BYTES=536870912

# Azure-native operations agent
AZURE_OPENAI_ENDPOINT=https://ezvids-resource.services.ai.azure.com/openai/v1/responses
AZURE_OPENAI_API_KEY=store_as_container_app_secret
AZURE_OPENAI_MODEL=gpt-4.1-mini
AGENT_ADMIN_GROUP=ezcopyright-admin
# After the owner signs in with Clerk, add their Clerk/OIDC subject here.
AGENT_ADMIN_USER_IDS=

# Authentication cutover
# Keep AUTH_MODE=easy-auth during deployment/testing. Switch to clerk only after
# the Clerk production instance is ready and the public key below is configured.
AUTH_MODE=easy-auth
AUTH_PROVIDER=ezid

# Direct Clerk authentication (used when AUTH_MODE=clerk)
# Publishable keys are public identifiers. Never put a Clerk Secret Key in a VITE_ variable.
CLERK_PUBLISHABLE_KEY=pk_live_your_publishable_key
CLERK_FRONTEND_API=https://clerk.ezwaycopyrights.com
CLERK_AUTHORIZED_PARTIES=https://ezwaycopyrights.com
# Optional override; defaults to CLERK_FRONTEND_API/.well-known/jwks.json
CLERK_JWKS_URL=

# No Cognito browser or server credentials are required by the application.
