# Browser configuration
# Production uses the same origin for React + API, so VITE_API_BASE_URL can stay empty.
VITE_API_BASE_URL=

# Server runtime
NODE_ENV=production
DATABASE_URL=postgresql://user:password@host:5432/database
DATABASE_SSL=true
CORS_ALLOWED_ORIGINS=https://ezwaycopyrights.com
APP_BASE_URL=https://ezwaycopyrights.com
POLICY_VERSION=2026-08-13

# Azure Blob Storage
STORAGE_PROVIDER=azure
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_CONTAINER=private-audio
AZURE_STORAGE_ACCOUNT_KEY=store_as_container_app_secret
AZURE_LOCATION=eastus2

# Stripe
STRIPE_SECRET_KEY=store_as_container_app_secret
STRIPE_WEBHOOK_SECRET=store_as_container_app_secret
STRIPE_PRICE_ID=price_your_recurring_price
MONTHLY_REGISTRATION_LIMIT=5
MAX_UPLOAD_BYTES=536870912

# Optional AWS operations-agent bridge
AWS_REGION=us-west-2
AGENT_FUNCTION_NAME=ezcopyright-agent-brain
AGENT_ADMIN_GROUP=ezcopyright-admin

# Authentication is provided by Azure Container Apps Authentication (Easy Auth).
# AUTH_PROVIDER is the configured provider alias, for example "auth0".
AUTH_PROVIDER=auth0
# No Cognito browser or server credentials are required by the application.
